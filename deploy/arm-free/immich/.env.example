# Immich environment. install-arm-free.sh copies this to .env and fills in the values
# marked (installer). Both modes are described in docker-compose.yml.

# Library location. Device mode: the Syncthing replica of the PC library.
# arm-free mode: the live library (Send Only folder "immich-library").
UPLOAD_LOCATION=/srv/orbit/immich-library
# Postgres data dir (installer): /srv/orbit/immich-db (arm-free mode) or
# /srv/orbit/immich-standby-db (device mode, restored from a PC dump on promote).
DB_DATA_LOCATION=/srv/orbit/immich-db

TZ=Etc/UTC
# Pin the major version. In device mode run the SAME major as the PC.
IMMICH_VERSION=v3

# Device mode: copy the exact image (tag@sha256:digest) from the PC's Immich
# docker-compose.yml, it MUST match the PC. arm-free mode: the default is fine.
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0

DB_USERNAME=postgres
# Placeholder. arm-free mode: the installer generates a random password (openssl rand -hex 24).
# Device mode: must equal the PC's DB_PASSWORD.
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich

# Bind address for port 2283 (installer: Tailscale IP of this VM):
TAILSCALE_IP=100.x.y.z

# Immich config file (immich-config.json, generated by the installer). While set, the
# settings it covers are READ-ONLY in the Immich admin UI. Comment out to manage them in the UI.
IMMICH_CONFIG_FILE=/config/immich.json

# Compose profiles (installer): "ml" starts the machine-learning container (arm-free mode only).
COMPOSE_PROFILES=

# Resource limits for the 4-core / 24 GB Arm VM:
IMMICH_SERVER_CPUS=1.5
IMMICH_ML_CPUS=1.0
IMMICH_ML_MEM=3g
