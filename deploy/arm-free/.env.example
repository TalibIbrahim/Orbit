# Copy to .env (install-arm-free.sh does this and fills TAILSCALE_IP).
# Output of `tailscale ip -4` on this VM:
TAILSCALE_IP=100.x.y.z
# URL other devices use to reach the hub:
ORBIT_HUB_URL=http://arm-free.your-tailnet.ts.net:3000
# Optional dashboard password for the hub (empty = rely on Tailscale ACLs):
ORBIT_PASSWORD=
# Optional: update notifications (also read by scripts/update.sh):
DISCORD_WEBHOOK_URL=
