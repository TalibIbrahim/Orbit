# Immich standby environment. Copy to .env and use the SAME DB_* values as on the PC.

# Replica of the PC library (Syncthing folder id "immich-library"):
UPLOAD_LOCATION=/srv/orbit/immich-library
# Fresh Postgres data dir on the standby (restored from /srv/orbit/immich-db-dumps):
DB_DATA_LOCATION=/srv/orbit/immich-standby-db

TZ=Etc/UTC
# Pin the major version. Run the SAME major as the PC.
IMMICH_VERSION=v3

# Copy the exact image (tag@sha256:digest) from the PC's Immich docker-compose.yml, e.g.
# ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:<digest>
IMMICH_POSTGRES_IMAGE=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0

DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE_NAME=immich

# Bind address for port 2283 (Tailscale IP of this VM):
TAILSCALE_IP=100.x.y.z

# No ML on the Arm free VM:
IMMICH_MACHINE_LEARNING_ENABLED=false
