#!/usr/bin/env bash
# Orbit agent installer (Linux replica) - generated by the hub "Add device" wizard.
# Placeholders replaced by the hub: __HUB_URL__ __TOKEN__ __DEVICE_ID__ __DEVICE_NAME__ __ROLE__ __TS_AUTHKEY__
# Idempotent: safe to run again (keeps existing /etc/orbit/agent.json).
set -euo pipefail

HUB_URL='__HUB_URL__'
TOKEN='__TOKEN__'
DEVICE_ID='__DEVICE_ID__'
DEVICE_NAME='__DEVICE_NAME__'
ROLE='__ROLE__'
TS_AUTHKEY='__TS_AUTHKEY__'

ORBIT_USER=orbit
ORBIT_HOME=/var/lib/orbit-sync
ST_HOME="${ORBIT_HOME}/syncthing"
REPLICA_ROOT=/srv/orbit/replicas
AGENT_DIR=/opt/orbit/agent
CFG=/etc/orbit/agent.json

log() { printf '[orbit] %s\n' "$*"; }
die() { printf '[orbit] ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run as root: re-run the command from Orbit (Devices -> Add device) with sudo"
command -v systemctl >/dev/null 2>&1 || die "systemd is required"

if command -v apt-get >/dev/null 2>&1; then PM=apt
elif command -v dnf >/dev/null 2>&1; then PM=dnf
else die "unsupported distro (need apt or dnf)"; fi
log "package manager: ${PM}"

ARCH_RAW="$(uname -m)"
case "$ARCH_RAW" in x86_64) ST_ARCH=amd64 ;; aarch64|arm64) ST_ARCH=arm64 ;; *) ST_ARCH="" ;; esac

pkg_install() {
  if [ "$PM" = apt ]; then DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"; else dnf install -y "$@"; fi
}

if [ "$PM" = apt ]; then apt-get update -y; fi
pkg_install curl ca-certificates jq restic rsync openssl >/dev/null 2>&1 || pkg_install curl ca-certificates jq rsync openssl
command -v restic >/dev/null 2>&1 || log "restic not available from the distro repo (optional); install it later if you want offsite backups"

# --- Tailscale ---------------------------------------------------------------------------
if ! command -v tailscale >/dev/null 2>&1; then
  log "installing Tailscale"
  curl -fsSL https://tailscale.com/install.sh | sh
fi
systemctl enable --now tailscaled
if ! tailscale ip -4 >/dev/null 2>&1; then
  if [ -n "$TS_AUTHKEY" ]; then
    tailscale up --authkey "$TS_AUTHKEY" --hostname "$DEVICE_NAME"
  else
    log "Tailscale is not logged in. Run:  sudo tailscale up   (open the printed URL), then re-run this installer."
  fi
fi
TS_IP="$(tailscale ip -4 2>/dev/null | head -n 1 || true)"

# --- orbit user + replica root -----------------------------------------------------------
if ! id "$ORBIT_USER" >/dev/null 2>&1; then
  useradd --system --create-home --home-dir "$ORBIT_HOME" --shell /usr/sbin/nologin "$ORBIT_USER"
fi
mkdir -p "$REPLICA_ROOT" "$ST_HOME" "$AGENT_DIR" /etc/orbit /var/lib/orbit
chown -R "${ORBIT_USER}:${ORBIT_USER}" /srv/orbit "$ORBIT_HOME"
chmod 700 /etc/orbit

# --- Syncthing v2 ------------------------------------------------------------------------
install_syncthing_tarball() {
  [ -n "$ST_ARCH" ] || die "no Syncthing build for ${ARCH_RAW}"
  local url
  url="$(curl -fsSL https://api.github.com/repos/syncthing/syncthing/releases/latest \
        | jq -r --arg a "linux-${ST_ARCH}" '[.assets[] | select(.name | test("^syncthing-" + $a + "-v2.*\\.tar\\.gz$")) | .browser_download_url][0] // empty')"
  [ -n "$url" ] || die "could not find a Syncthing v2 tarball"
  local tmp; tmp="$(mktemp -d)"
  curl -fsSL "$url" | tar -xz -C "$tmp" --strip-components=1
  install -m 0755 "$tmp/syncthing" /usr/local/bin/syncthing
  rm -rf "$tmp"
}

if ! command -v syncthing >/dev/null 2>&1; then
  log "installing Syncthing"
  if [ "$PM" = apt ]; then
    install -d -m 0755 /etc/apt/keyrings
    curl -fsSL https://syncthing.net/release-key.gpg -o /etc/apt/keyrings/syncthing-archive-keyring.gpg
    echo "deb [signed-by=/etc/apt/keyrings/syncthing-archive-keyring.gpg] https://apt.syncthing.net/ syncthing stable-v2" \
      > /etc/apt/sources.list.d/syncthing.list
    printf 'Package: *\nPin: origin apt.syncthing.net\nPin-Priority: 990\n' > /etc/apt/preferences.d/syncthing
    apt-get update -y
    pkg_install syncthing
  else
    pkg_install syncthing || install_syncthing_tarball
  fi
fi
ST_BIN="$(command -v syncthing)"

# Own unit template if the package did not ship syncthing@.service.
if [ ! -f /usr/lib/systemd/system/syncthing@.service ] && [ ! -f /lib/systemd/system/syncthing@.service ] \
   && [ ! -f /etc/systemd/system/syncthing@.service ]; then
  cat > /etc/systemd/system/syncthing@.service <<UNIT
[Unit]
Description=Syncthing - Open Source Continuous File Synchronization for %i
After=network.target

[Service]
User=%i
ExecStart=${ST_BIN} serve --no-browser --no-restart
Restart=on-failure
RestartSec=5
SuccessExitStatus=3 4
RestartForceExitStatus=3 4

[Install]
WantedBy=multi-user.target
UNIT
fi

# Pin config location + GUI to loopback via a drop-in (works for packaged and own unit).
mkdir -p "/etc/systemd/system/syncthing@${ORBIT_USER}.service.d"
cat > "/etc/systemd/system/syncthing@${ORBIT_USER}.service.d/orbit.conf" <<UNIT
[Service]
Environment=STHOMEDIR=${ST_HOME}
Environment=STGUIADDRESS=127.0.0.1:8384
Environment=STNOUPGRADE=1
Nice=10
UNIT
systemctl daemon-reload
systemctl enable --now "syncthing@${ORBIT_USER}.service"

# --- Node 22 -----------------------------------------------------------------------------
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 22 ]; then
  log "installing Node 22"
  if [ "$PM" = apt ]; then
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
  else
    curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
  fi
  pkg_install nodejs
fi
NODE_BIN="$(command -v node)"

# --- agent bundle ------------------------------------------------------------------------
log "downloading agent bundle"
curl -fsSL "${HUB_URL}/agent/orbit-agent.mjs" -o "${AGENT_DIR}/orbit-agent.mjs.new"
mv "${AGENT_DIR}/orbit-agent.mjs.new" "${AGENT_DIR}/orbit-agent.mjs"

# --- config ------------------------------------------------------------------------------
if [ ! -f "$CFG" ]; then
  LISTEN_HOST="${TS_IP:-0.0.0.0}"
  jq -n --arg id "$DEVICE_ID" --arg name "$DEVICE_NAME" --arg role "$ROLE" --arg token "$TOKEN" \
        --arg host "$LISTEN_HOST" --arg hub "$HUB_URL" --arg cfg "${ST_HOME}/config.xml" \
    '{deviceId:$id, name:$name, role:$role, token:$token,
      listen:{host:$host, port:7420}, hubUrl:$hub, dataDir:"/var/lib/orbit",
      sampleIntervalSec:60, sizeIntervalMin:10, retentionDays:35, autoUpdate:true,
      services:[], syncthing:{url:"http://127.0.0.1:8384", configPath:$cfg}, jobs:[]}' > "${CFG}.tmp"
  mv "${CFG}.tmp" "$CFG"
  chmod 600 "$CFG"
  log "wrote ${CFG} (listen ${LISTEN_HOST}:7420)"
else
  log "${CFG} exists; keeping it"
fi

# --- systemd service ---------------------------------------------------------------------
cat > /etc/systemd/system/orbit-agent.service <<UNIT
[Unit]
Description=Orbit agent
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=${NODE_BIN} ${AGENT_DIR}/orbit-agent.mjs --config ${CFG}
# The agent self-updates by replacing its bundle and exiting; systemd restarts it.
Restart=always
RestartSec=5
Nice=5
StateDirectory=orbit

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable orbit-agent.service
systemctl restart orbit-agent.service

echo
log "Orbit agent installed"
echo "  device     : ${DEVICE_NAME} (${DEVICE_ID}), role ${ROLE}"
echo "  tailscale  : ${TS_IP:-NOT CONNECTED - run 'sudo tailscale up'}"
echo "  syncthing  : syncthing@${ORBIT_USER} (GUI 127.0.0.1:8384, config ${ST_HOME}/config.xml)"
echo "  replicas   : ${REPLICA_ROOT}"
echo "  agent      : systemctl status orbit-agent   (port 7420)"
echo "The agent enrolls with ${HUB_URL} on start; the hub then pairs Syncthing automatically."
