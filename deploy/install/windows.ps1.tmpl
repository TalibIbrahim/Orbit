# Orbit agent installer (Windows replica) - generated by the hub "Add device" wizard.
# Placeholders replaced by the hub: __HUB_URL__ __TOKEN__ __DEVICE_ID__ __DEVICE_NAME__ __ROLE__ __TS_AUTHKEY__
# Run in an ELEVATED Windows PowerShell 5.1. Idempotent.
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$HubUrl = '__HUB_URL__'.TrimEnd('/')
$Token = '__TOKEN__'
$DeviceId = '__DEVICE_ID__'
$DeviceName = '__DEVICE_NAME__'
$Role = '__ROLE__'
$TsAuthKey = '__TS_AUTHKEY__'

function Step([string]$m) { Write-Host ""; Write-Host "==> $m" -ForegroundColor Cyan }
function Have([string]$c) { [bool](Get-Command $c -ErrorAction SilentlyContinue) }
function Refresh-Path { $env:Path = [Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [Environment]::GetEnvironmentVariable("Path", "User") }
function Write-Utf8NoBom([string]$p, [string]$t) { [IO.File]::WriteAllText($p, $t, (New-Object Text.UTF8Encoding($false))) }
function Winget-Install([string]$id, [string]$probe) {
  if (Have $probe) { Write-Host "  $id already installed"; return }
  Write-Host "  installing $id"
  & winget install --id $id -e --accept-package-agreements --accept-source-agreements --silent
}

$isAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) { throw "Run in an elevated (Administrator) PowerShell." }
if (-not (Have "winget")) { throw "winget not found. Install 'App Installer' from the Microsoft Store." }

Step "Installing Tailscale, Syncthing, Node.js"
Winget-Install "Tailscale.Tailscale" "tailscale"
Winget-Install "Syncthing.Syncthing" "syncthing"
Winget-Install "OpenJS.NodeJS.LTS" "node"
Refresh-Path

Step "Tailscale"
if (Have "tailscale") {
  $ip = (& tailscale ip -4 2>$null | Select-Object -First 1)
  if (-not $ip -and $TsAuthKey) { & tailscale up --authkey $TsAuthKey --hostname $DeviceName; $ip = (& tailscale ip -4 2>$null | Select-Object -First 1) }
  if (-not $ip) { Write-Warning "Tailscale is not logged in. Run 'tailscale up' (or use the tray icon), then re-run this script." }
}
$tsIp = if ($ip) { $ip } else { "0.0.0.0" }

Step "Agent files"
$orbitDir = "$env:ProgramFiles\Orbit"
$dataDir = "$env:ProgramData\Orbit"
foreach ($d in @($orbitDir, $dataDir, "$dataDir\logs", "C:\OrbitReplicas")) {
  try { New-Item -ItemType Directory -Force -Path $d | Out-Null } catch { Write-Warning "could not create $d" }
}
Invoke-WebRequest "$HubUrl/agent/orbit-agent.mjs" -OutFile "$orbitDir\orbit-agent.mjs" -UseBasicParsing

# Self-restarting runner (the agent exits after a self-update).
$runner = @'
param([string]$Bundle = "C:\Program Files\Orbit\orbit-agent.mjs", [string]$Config = "C:\ProgramData\Orbit\agent.json", [string]$LogDir = "C:\ProgramData\Orbit\logs")
New-Item -ItemType Directory -Force -Path $LogDir | Out-Null
$log = Join-Path $LogDir "agent.log"
function Write-Log([string]$m) { Add-Content -Path $log -Value ("[{0}] {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $m) -Encoding UTF8 }
$env:Path = "$env:ProgramFiles\nodejs;$env:ProgramFiles\Docker\Docker\resources\bin;$env:Path"
$env:ORBIT_AGENT_CONFIG = $Config
$node = (Get-Command node.exe -ErrorAction SilentlyContinue).Source
if (-not $node) { Write-Log "node.exe not found"; exit 1 }
while ($true) {
  if ((Test-Path $log) -and ((Get-Item $log).Length -gt 10MB)) { Move-Item -Force $log "$log.1" }
  Write-Log "starting agent"
  & cmd.exe /d /c ('"{0}" "{1}" --config "{2}" >> "{3}" 2>&1' -f $node, $Bundle, $Config, $log)
  Write-Log "agent exited ($LASTEXITCODE); restarting in 5 s"
  Start-Sleep -Seconds 5
}
'@
Write-Utf8NoBom "$orbitDir\orbit-agent-runner.ps1" $runner

$syncExe = (Get-Command syncthing.exe -ErrorAction SilentlyContinue).Source
if (-not $syncExe) {
  $syncExe = Get-ChildItem -Path "$env:LOCALAPPDATA\Microsoft\WinGet\Packages", "$env:ProgramFiles\Syncthing" -Recurse -Filter syncthing.exe `
      -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty FullName
}

$cfgPath = "$dataDir\agent.json"
if (-not (Test-Path $cfgPath)) {
  $cfg = [ordered]@{
    deviceId = $DeviceId; name = $DeviceName; role = $Role; token = $Token
    listen = [ordered]@{ host = $tsIp; port = 7420 }
    hubUrl = $HubUrl; dataDir = "$dataDir\data"
    sampleIntervalSec = 60; sizeIntervalMin = 10; retentionDays = 35; autoUpdate = $true
    services = @()
    syncthing = [ordered]@{ url = "http://127.0.0.1:8384"; configPath = (Join-Path $env:LOCALAPPDATA "Syncthing\config.xml") }
    jobs = @()
  }
  Write-Utf8NoBom $cfgPath ($cfg | ConvertTo-Json -Depth 10)
  & icacls.exe $cfgPath /inheritance:r /grant:r "SYSTEM:(F)" "Administrators:(F)" | Out-Null
  Write-Host "  wrote $cfgPath"
} else { Write-Host "  $cfgPath exists, keeping it" }

Step "Scheduled tasks"
$ps = "$env:SystemRoot\System32\WindowsPowerShell\v1.0\powershell.exe"
$act = New-ScheduledTaskAction -Execute $ps -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$orbitDir\orbit-agent-runner.ps1`""
$trg = New-ScheduledTaskTrigger -AtStartup
$pri = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
$set = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew
Register-ScheduledTask -TaskName "Orbit Agent" -Action $act -Trigger $trg -Principal $pri -Settings $set -Force | Out-Null
Start-ScheduledTask -TaskName "Orbit Agent"

if ($syncExe) {
  $sAct = New-ScheduledTaskAction -Execute $syncExe -Argument "--no-browser --no-console"
  $sTrg = New-ScheduledTaskTrigger -AtLogOn -User "$env:USERDOMAIN\$env:USERNAME"
  $sPri = New-ScheduledTaskPrincipal -UserId "$env:USERDOMAIN\$env:USERNAME" -LogonType Interactive -RunLevel Limited
  $sSet = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)
  Register-ScheduledTask -TaskName "Syncthing" -Action $sAct -Trigger $sTrg -Principal $sPri -Settings $sSet -Force | Out-Null
  Start-ScheduledTask -TaskName "Syncthing"
} else { Write-Warning "syncthing.exe not found; open a new shell and re-run, or install SyncTrayzor." }

Step "Firewall (TCP 7420 from Tailscale only)"
Get-NetFirewallRule -DisplayName "Orbit Agent (Tailscale)" -ErrorAction SilentlyContinue | Remove-NetFirewallRule
New-NetFirewallRule -DisplayName "Orbit Agent (Tailscale)" -Direction Inbound -Protocol TCP -LocalPort 7420 -RemoteAddress "100.64.0.0/10" -Action Allow -Profile Any | Out-Null

Step "Summary"
Write-Host "  device    : $DeviceName ($DeviceId), role $Role"
Write-Host "  tailscale : $(if ($ip) { $ip } else { 'NOT CONNECTED - run tailscale up' })"
Write-Host "  agent     : scheduled task 'Orbit Agent' (log: $dataDir\logs\agent.log)"
Write-Host "  syncthing : scheduled task 'Syncthing' (GUI http://127.0.0.1:8384)"
Write-Host "The agent enrolls with $HubUrl on start; the hub then pairs Syncthing."
