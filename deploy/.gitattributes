# Scripts, templates and unit files run on Linux: always LF (a stray CR breaks shebangs).
*.sh         text eol=lf
*.tmpl       text eol=lf
*.service    text eol=lf
*.timer      text eol=lf
*.yml        text eol=lf
*.json       text eol=lf
web.Dockerfile text eol=lf
# PowerShell does not care; leave as authored.
*.ps1        text
